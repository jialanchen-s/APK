# 复制为 .env 后填入真实值（.env 已被 gitignore，不要提交）
# cp .env.example .env

# ============================================================
# Server (NestJS)
# ============================================================
# 必填：本地 PostgreSQL 连接串，无兜底默认值
SUDA_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/apk_db
FORCE_AUTHN_INNERAPI_DOMAIN=http://localhost
SERVER_HOST=localhost
SERVER_PORT=3000

# ============================================================
# Client (Vite dev server)
# ============================================================
# CLIENT_DEV_HOST=localhost
# CLIENT_DEV_PORT=8080

# ============================================================
# Logger
# ============================================================
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# ============================================================
# AI Gateway
# ============================================================
# 不填任何 API_KEY 时，网关只注册 MockLLMAdapter（固定返回空结果），
# 模型匹配、参数提取等 AI 能力会静默返回空结果，不会抛错。
#
# 适配器仅在其 API_KEY 存在时才注册，所以务必「先填密钥，再改
# AI_DEFAULT_PROVIDER」；否则默认适配器不存在，调用时直接失败。

# 可选值：deepseek | openai | custom | mock（留空等价于 mock）
# AI_DEFAULT_PROVIDER=deepseek

# 降级链：主 provider 失败时按顺序尝试，逗号分隔
# AI_FALLBACK_CHAIN=deepseek,mock

# ---- DeepSeek（OpenAI 兼容接口，国内可直连）----
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- OpenAI ----
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=

# ---- 自定义 OpenAI 兼容服务（本地 vLLM / Ollama / 中转站）----
# 四项必须全部填写，缺一则不注册
# CUSTOM_LLM_NAME=my-llm
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_MODEL=

# ---- 缓存（留空则用默认值：1000 条 / 1 小时）----
# AI_CACHE_MAX_SIZE=1000
# AI_CACHE_DEFAULT_TTL_MS=3600000

# ---- 按任务路由（JSON 数组，解析失败则忽略）----
# 每项形如 {"taskKey":"...","primary":"...","fallbacks":["..."]}
# AI_ROUTES_JSON=[{"taskKey":"model-match","primary":"deepseek","fallbacks":["mock"]}]
